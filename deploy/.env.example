# Настройки AUF ID на сервере. Скопируйте в .env рядом с compose.yaml и заполните:
#
#   cp .env.example .env && chmod 600 .env
#
# .env — секреты: в git не коммитить (он в .gitignore), на сервере права 600.
# Пустое значение там, где оно обязательно, остановит запуск с понятной ошибкой — так и задумано.

# ─────────────────────────── адрес и версия ───────────────────────────

# Домен без https:// — он должен указывать на этот сервер (запись A в DNS), порты 80 и 443 открыты.
# Из него собирается публичный адрес: issuer в токенах и ссылки активации.
# ⚠️ Сменить домен = сменить issuer: все выданные токены станут недействительны, а сервисам
# (планировщик, лаунчер) придётся поменять адрес у себя.
# Для проверки на своём компьютере — localhost.
AUF_ID_DOMAIN=

# Какой образ запускать: sha-<7 символов коммита> (список — GitHub → Packages → auf-id) или latest.
# На сервере лучше конкретный sha: известно, что запущено, и откат — правка одной строки.
AUF_ID_IMAGE_TAG=latest

# ─────────────────────────── база данных ───────────────────────────

DB_NAME=auth
DB_USER=auth
# openssl rand -hex 24
DB_PASSWORD=

# ─────────────────────────── секреты приложения ───────────────────────────
# Генерировать на сервере, НЕ копировать локальные. Хранить копию вне сервера (менеджер паролей):
# потеря любого из них — это не «сгенерировать новый», см. предупреждения.

# Перец для паролей, не короче 32 символов.        openssl rand -base64 48
# ⚠️ Постоянный: сменить = все пароли перестанут подходить.
PASSWORD_PEPPER=

# Подпись задачек капчи.                            openssl rand -base64 48
# Сменить можно: пострадают лишь задачки, выданные в последние 10 минут.
CAPTCHA_SECRET=

# Ключ подписи токенов (ES256, PKCS#8, base64). Именно так — OpenSSL 3 без pkcs8 выдаёт формат,
# который Java не читает:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# ⚠️ Сменить = все выданные токены недействительны, всем войти заново.
JWT_SIGNING_KEY=

# ─────────────────────────── первый администратор ───────────────────────────

# Почта (или несколько через запятую) в домене колледжа. Пока в системе нет ни одного
# администратора, при запуске для неё создаётся учётка, а ссылка активации пишется в лог:
#   docker compose logs auf-id | grep activate
# Потеряли ссылку — перезапустите auf-id, выдастся новая.
BOOTSTRAP_ADMIN_EMAILS=

# ─────────────────────────── подключённые сервисы ───────────────────────────

# Сайты браузерных приложений (планировщик и т.п.), которым можно обращаться к AUF ID из
# JavaScript: схема://домен[:порт], через запятую. Пусто — CORS выключен.
AUTH_CORS_ALLOWED_ORIGINS=

# ─────────────────────────── по желанию ───────────────────────────

# Swagger UI (/swagger-ui/index.html). Пока нет веб-админки, это единственный удобный способ
# работать с Admin API, поэтому включён. Появится админка — выключить обе строки (false).
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Почты каких доменов допускаются (через запятую). Умолчание — sinhub.ru.
#AUTH_ALLOWED_EMAIL_DOMAINS=sinhub.ru

# Попыток входа в минуту с одного IP. Колледж, скорее всего, за общим NAT — подобрать по логам.
#AUTH_LOGIN_RATE_LIMIT=300
#AUTH_TOKEN_RATE_LIMIT=600
